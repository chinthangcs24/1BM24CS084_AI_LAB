def print_board(board):
    for i in range(0, 9, 3):
        print(" | ".join(board[i:i+3]))
        if i < 6:
            print("---------")

def check_winner(board):
    wins = [(0,1,2), (3,4,5), (6,7,8),
            (0,3,6), (1,4,7), (2,5,8),
            (0,4,8), (2,4,6)]

    for a, b, c in wins:
        if board[a] == board[b] == board[c] != " ":
            return board[a]
    return None

def tic_tac_toe():
    board = [" "] * 9
    player = "X"

    while True:
        print_board(board)

        try:
            move = int(input(f"Player {player}, enter position (1-9): ")) - 1
        except ValueError:
            print("Enter a valid number.")
            continue

        if move < 0 or move > 8 or board[move] != " ":
            print("Invalid move!")
            continue

        board[move] = player

        winner = check_winner(board)

        if winner:
            print_board(board)
            print(winner, "wins!")
            break

        if " " not in board:
            print_board(board)
            print("It's a draw!")
            break

        player = "O" if player == "X" else "X"

tic_tac_toe()
